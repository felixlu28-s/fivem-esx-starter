# Copy to server.cfg and replace all CHANGE_ME values.

endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"

sv_hostname "CHANGE_ME RP"
sets sv_projectName "CHANGE_ME RP"
sets sv_projectDesc "ESX Legacy custom roleplay server"
sets locale "de-DE"

sv_maxclients 48
set onesync on

set mysql_connection_string "mysql://fivem:CHANGE_ME@127.0.0.1:3306/fivem?charset=utf8mb4"

ensure spawnmanager
ensure baseevents
ensure oxmysql
ensure ox_lib
ensure esx_lib
ensure es_extended
ensure skinchanger

# ESX owns the single-character login and spawn flow. skinchanger is required.
# Add selected ESX resources here in explicit order; do not enable a second spawn flow.

ensure rp_core
ensure rp_characters
ensure rp_ui

sv_licenseKey "CHANGE_ME"
